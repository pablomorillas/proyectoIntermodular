# Variables de entorno para la API Spring Boot
# Copia este archivo a .env y rellena los valores reales (NO subas .env a Git)

# Para desarrollo local con MySQL en localhost:
DB_URL=jdbc:mysql://localhost:3306/requestructure_db?createDatabaseIfNotExist=true&serverTimezone=Europe/Madrid
DB_USER=root
DB_PASSWORD=

# Para produccion (Render) usar la URL de la BD gestionada, ej. Railway:
# DB_URL=jdbc:mysql://zephyr.proxy.rlwy.net:45707/railway?createDatabaseIfNotExist=true&serverTimezone=Europe/Madrid
# DB_USER=root
# DB_PASSWORD=lUmsmfwXmRXSDNWdWQYjzXVYKYUrtvzM
PORT=8080
